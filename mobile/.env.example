# ── Supabase ─────────────────────────────────────────────────
# Same project as the web app (lib/supabase/client.ts).
# Find these in: Supabase Dashboard → Project Settings → API
#
# NOTE: In Expo, only variables prefixed with EXPO_PUBLIC_ are
# exposed to the app bundle. The anon key is safe to ship to the
# client — row-level security (RLS) protects the data.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
